# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# O .env real não é versionado (ver .gitignore).

JWT_SECRET_KEY="chave-de-desenvolvimento-nao-use-em-producao"

# URL AMQP da instância do RabbitMQ usada na mensageria entre as agências.
# Precisa ser a MESMA nas 3 agências, já que todas publicam e consomem da
# exchange iceibank.eventos. No CloudAMQP, copie a URL do painel da instância.
# Sem esta variável a agência não inicia.
RABBITMQ_URL="amqps://usuario:senha@host.cloudamqp.com/vhost"
